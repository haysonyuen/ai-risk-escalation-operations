{
  "rule_version": "rules-v1.0",
  "status": "baseline",
  "created": "2026-09-28",
  "description": "Simple rules-only baseline written directly from the framework's severity table before any evaluation was run. Keyword lexicons plus structured intake fields; first matching severity rule wins.",
  "default_severity": "P3",
  "default_route": "support",
  "lexicons": {
    "harmful_topic": ["pathogen", "viral culture", "viral cultures", "live culture", "live cultures", "select agent", "toxin", "nerve agent", "weapon", "explosive", "credential-harvesting", "credential harvesting", "malware", "ransomware", "exploit kit", "dangerous biological", "biological material", "hazardous chemical", "restricted chemical", "procure"],
    "assistant_provided": ["provided", "offered to", "listed", "gave", "generated", "supplied", "walked the user through", "produced", "drafted"],
    "assistant_refused": ["refused", "declined", "did not provide", "would not", "safety message", "redirected"],
    "external_exposure": ["sent to an external", "external recipient", "emailed", "shared publicly", "public link", "uploaded to", "posted to", "outside the organization", "external domain"],
    "cross_tenant": ["another customer", "another user's", "other tenant", "different organization's", "someone else's"],
    "injection_influence": ["hidden instruction", "hidden instructions", "embedded instruction", "embedded instructions", "instructions hidden", "text on the page instructed", "the document contained instructions", "injected", "prompt injection", "white text"],
    "approval_fatigue": ["approved without reading", "approve without", "too many approval", "approval prompts", "clicked approve", "rubber-stamp", "approval fatigue"],
    "synthetic_media": ["synthetic image", "synthetic video", "synthetic audio", "voice clone", "cloned voice", "deepfake", "face swap", "likeness", "fabricated photo"],
    "real_person": ["real person", "public figure", "coworker", "colleague", "named individual", "politician", "real individual", "classmate"],
    "inaccurate_output": ["incorrect", "inaccurate", "fabricated citation", "fabricated citations", "made-up", "made up", "hallucinated", "hallucination", "wrong figures", "wrong answer", "nonexistent", "false statement"],
    "product_failure": ["crash", "crashes", "crashed", "timeout", "timed out", "failed to load", "error message", "broken", "stopped working", "outage", "latency"],
    "benign": ["feature request", "how do i", "question about", "working as designed", "working as expected", "test report", "testing the form", "no issue", "suggestion"],
    "contradiction": ["no record", "does not show", "do not show", "logs show no", "contradict", "contradicts", "inconsistent with", "not present in the log", "no matching"],
    "containment_appeal": ["safe mode", "was restricted", "access was restricted", "appeal", "reinstate", "locked out", "false positive"]
  },
  "corroboration_signals": ["harmful_topic", "external_exposure", "cross_tenant", "injection_influence", "approval_fatigue", "synthetic_media", "inaccurate_output", "product_failure", "containment_appeal"],
  "severity_rules": [
    {"id": "SEV-P0-01", "severity": "P0", "description": "Harmful-topic report where the assistant provided or offered assistance and did not refuse.", "all": ["harmful_topic", "assistant_provided"], "none": ["assistant_refused"]},
    {"id": "SEV-P0-02", "severity": "P0", "description": "Sensitive data confirmed, external action attempted and external exposure language present.", "all": ["sensitive_yes", "external_yes", "external_exposure"]},
    {"id": "SEV-P1-01", "severity": "P1", "description": "Any harmful-topic report not meeting P0.", "any": ["harmful_topic"]},
    {"id": "SEV-P1-02", "severity": "P1", "description": "Sensitive data possible or confirmed for an enterprise customer or with an external action.", "all": ["sensitive_any"], "any": ["enterprise", "external_yes"]},
    {"id": "SEV-P1-03", "severity": "P1", "description": "Untrusted-instruction influence together with an external action or file modification.", "all": ["injection_influence"], "any": ["external_yes", "file_modified"]},
    {"id": "SEV-P1-04", "severity": "P1", "description": "Action taken without user approval that was external or deleted a file.", "all": ["approved_no"], "any": ["external_yes", "file_deleted"]},
    {"id": "SEV-P1-05", "severity": "P1", "description": "Synthetic media depicting a real person.", "all": ["synthetic_media", "real_person"]},
    {"id": "SEV-P2-01", "severity": "P2", "description": "Material user impact or recurring product/UX failure.", "any": ["file_modified", "approval_fatigue", "repeated", "synthetic_media", "product_failure", "containment_appeal"]},
    {"id": "SEV-P2-02", "severity": "P2", "description": "Inaccurate output reported by an enterprise customer.", "all": ["inaccurate_output", "enterprise"]}
  ],
  "severity_floors": [],
  "impact_rules": [
    {"level": "critical", "any": ["harmful_topic"]},
    {"level": "high", "all": ["sensitive_any"], "any": ["external_yes", "enterprise", "cross_tenant"]},
    {"level": "high", "any": ["injection_influence", "cross_tenant"]},
    {"level": "high", "all": ["approved_no"], "any": ["external_yes", "file_deleted"]},
    {"level": "moderate", "any": ["file_modified", "repeated", "multi_scope", "synthetic_media", "approval_fatigue", "containment_appeal"]}
  ],
  "category_rules": [
    {"category": "harmful_assistance", "any": ["harmful_topic"]},
    {"category": "sensitive_data", "any": ["sensitive_any", "cross_tenant"]},
    {"category": "prompt_injection", "any": ["injection_influence"]},
    {"category": "unintended_action", "all": ["approved_no"], "any": ["external_yes", "file_modified"]},
    {"category": "file_modification", "any": ["file_modified"]},
    {"category": "approval_ux", "any": ["approval_fatigue"]},
    {"category": "synthetic_media", "any": ["synthetic_media"]},
    {"category": "inaccurate_output", "any": ["inaccurate_output"]},
    {"category": "product_failure", "any": ["product_failure"]},
    {"category": "containment_appeal", "any": ["containment_appeal"]}
  ],
  "route_priority": [
    ["harmful_assistance", "safety"],
    ["sensitive_data", "legal_privacy"],
    ["prompt_injection", "product_security"],
    ["synthetic_media", "safety"],
    ["containment_appeal", "risk_ops"],
    ["unintended_action", "product_engineering"],
    ["file_modification", "product_engineering"],
    ["approval_ux", "product_ux"],
    ["product_failure", "product_engineering"],
    ["inaccurate_output", "product_engineering"],
    ["benign_noise", "support"]
  ],
  "teams": {
    "harmful_assistance": ["Safety", "Legal/Privacy", "Risk Ops"],
    "sensitive_data": ["Legal/Privacy", "Enterprise/CS", "Risk Ops", "Engineering"],
    "prompt_injection": ["Product Security", "Engineering", "Safety", "Product/UX"],
    "unintended_action": ["Engineering", "Product/UX", "Support", "Risk Ops"],
    "file_modification": ["Product/UX", "Engineering", "Support", "Risk Ops"],
    "approval_ux": ["Product/UX", "Support", "Risk Ops"],
    "synthetic_media": ["Safety", "Legal/Privacy", "Support"],
    "inaccurate_output": ["Engineering", "Product/UX", "Support"],
    "product_failure": ["Engineering", "Support"],
    "containment_appeal": ["Risk Ops", "Support", "Enterprise/CS"],
    "benign_noise": ["Support"]
  },
  "mandatory_review": [
    {"id": "REV-01", "description": "P0/P1 recommendation: a human must confirm severity and review source evidence.", "any": ["sev_P0", "sev_P1"]},
    {"id": "REV-02", "description": "Sensitive data possibly involved: Legal/Privacy-aware review required.", "any": ["sensitive_any"]}
  ],
  "containment_options": {
    "harmful_assistance": [
      {"action_type": "pause_interaction", "target": "the reported conversation/session", "rationale": "Stop continuation of potentially harmful assistance while Safety reviews.", "reversible": true, "offer_at_or_above": "P1"},
      {"action_type": "pause_external_transactions", "target": "procurement/transaction tool actions for the affected account", "rationale": "Prevent any external purchase or order flow while under review.", "reversible": true, "offer_at_or_above": "P1"}
    ],
    "sensitive_data": [
      {"action_type": "warn_sensitive_file_access", "target": "affected workspace", "rationale": "Add friction before sensitive file access while scope is assessed.", "reversible": true, "offer_at_or_above": "P1"},
      {"action_type": "restrict_tool_action", "target": "external send/share tool for the affected workspace", "rationale": "Prevent further external transmission pending investigation.", "reversible": true, "offer_at_or_above": "P1"}
    ],
    "prompt_injection": [
      {"action_type": "isolate_untrusted_instructions", "target": "web/file content ingestion for the affected surface", "rationale": "Treat instructions from untrusted content as data while Product Security investigates.", "reversible": true, "offer_at_or_above": "P2"}
    ],
    "unintended_action": [
      {"action_type": "require_confirmation_destructive", "target": "affected tool action", "rationale": "Require explicit confirmation before the action type can run again.", "reversible": true, "offer_at_or_above": "P2"}
    ],
    "file_modification": [
      {"action_type": "require_confirmation_destructive", "target": "file edit/delete actions on the affected surface", "rationale": "Add review friction for destructive edits.", "reversible": true, "offer_at_or_above": "P1"}
    ]
  }
}
