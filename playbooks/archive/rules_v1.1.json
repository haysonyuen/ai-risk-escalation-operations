  "severity_rules": [
    {
      "id": "SEV-P0-01",
      "severity": "P0",
      "description": "Harmful-topic report where the assistant provided or offered assistance and did not refuse.",
      "all": [
        "harmful_topic",
        "assistant_provided"
      ],
      "none": [
        "assistant_refused"
      ]
    },
    {
      "id": "SEV-P0-02",
      "severity": "P0",
      "description": "Sensitive data confirmed, external action attempted and external exposure language present.",
      "all": [
        "sensitive_yes",
        "external_yes",
        "external_exposure"
      ]
    },
    {
      "id": "SEV-P3-01",
      "severity": "P3",
      "description": "Harmful-topic report where the assistant refused and did not provide assistance: safeguard worked (route to Safety for sampling).",
      "all": [
        "harmful_topic",
        "assistant_refused"
      ],
      "none": [
        "assistant_provided"
      ]
    },
    {
      "id": "SEV-P1-01",
      "severity": "P1",
      "description": "Any harmful-topic report not meeting P0.",
      "any": [
        "harmful_topic"
      ]
    },
    {
      "id": "SEV-P1-02",
      "severity": "P1",
      "description": "Sensitive data possible or confirmed for an enterprise customer or with an external action.",
      "all": [
        "sensitive_any"
      ],
      "any": [
        "enterprise",
        "external_yes"
      ]
    },
    {
      "id": "SEV-P1-03",
      "severity": "P1",
      "description": "Untrusted-instruction influence together with an external action or file modification.",
      "all": [
        "injection_influence"
      ],
      "any": [
        "external_yes",
        "file_modified"
      ]
    },
    {
      "id": "SEV-P1-04",
      "severity": "P1",
      "description": "Action taken without user approval that was external or deleted a file.",
      "all": [
        "approved_no"
      ],
      "any": [
        "external_yes",
        "file_deleted"
      ]
    },
    {
      "id": "SEV-P1-05",
      "severity": "P1",
      "description": "Synthetic media depicting a real person.",
      "all": [
        "synthetic_media",
        "real_person"
      ]
    },
    {
      "id": "SEV-P2-01",
      "severity": "P2",
      "description": "File modification with a material signal (stated impact, repeated, multi-user, irreversible or enterprise).",
      "all": [
        "file_modified"
      ],
      "any": [
        "impact_stated",
        "repeated",
        "multi_scope",
        "irreversible",
        "enterprise"
      ]
    },
    {
      "id": "SEV-P2-02",
      "severity": "P2",
      "description": "Approval-friction pattern (repeated, multi-user or telemetry-backed) or approval failure with a destructive action.",
      "all": [
        "approval_fatigue"
      ],
      "any": [
        "repeated",
        "multi_scope",
        "file_deleted",
        "telemetry_evidence"
      ]
    },
    {
      "id": "SEV-P2-03",
      "severity": "P2",
      "description": "Recurring or multi-user product failure.",
      "all": [
        "product_failure"
      ],
      "any": [
        "repeated",
        "multi_scope"
      ]
    },
    {
      "id": "SEV-P2-04",
      "severity": "P2",
      "description": "Synthetic media report that is not a policy question.",
      "all": [
        "synthetic_media"
      ],
      "none": [
        "benign"
      ]
    },
    {
      "id": "SEV-P2-05",
      "severity": "P2",
      "description": "Inaccurate output reported by an enterprise customer or recurring.",
      "all": [
        "inaccurate_output"
      ],
      "any": [
        "enterprise",
        "repeated"
      ]
    },
    {
      "id": "SEV-P2-06",
      "severity": "P2",
      "description": "Appeal of containment (possible false positive) needs expedited human review.",
      "any": [
        "containment_appeal"
      ]
    },
    {
      "id": "SEV-P2-07",
      "severity": "P2",
      "description": "Approved action deleted a file (approval/UX failure).",
      "all": [
        "file_deleted",
        "approved_yes"
      ]
    }
  ],
  "severity_floors": [
    {
      "id": "FLOOR-01",
      "floor": "P1",
      "description": "Potential impact high/critical but evidence weak or missing: at least P1 until evidence is reviewed (low confidence must not lower severity).",
