  "mandatory_review": [
    {
      "id": "REV-01",
      "description": "P0/P1 recommendation: a human must confirm severity and review source evidence.",
      "any": [
        "sev_P0",
        "sev_P1"
      ]
    },
    {
      "id": "REV-02",
      "description": "Sensitive data possibly involved: Legal/Privacy-aware review required.",
      "any": [
        "sensitive_any"
      ]
    },
    {
      "id": "REV-03",
      "description": "Enterprise file modification or external action: customer-impacting conclusions need human review.",
      "all": [
        "enterprise"
      ],
      "any": [
        "file_modified",
        "external_yes"
      ]
    },
    {
      "id": "REV-04",
      "description": "Four or more key intake fields unknown: human triage needed before routing is relied on.",
      "any": [
        "many_unknowns"
      ]
    },
    {
      "id": "REV-05",
      "description": "A severity floor was applied: confirm or correct with evidence.",
      "any": [
        "floor_applied"
      ]
    }
  ],
  "containment_options": {
    "harmful_assistance": [
      {
        "action_type": "pause_interaction",
        "target": "the reported conversation/session",
        "rationale": "Stop continuation of potentially harmful assistance while Safety reviews.",
        "reversible": true,
        "offer_at_or_above": "P1"
      },
      {
        "action_type": "pause_external_transactions",
        "target": "procurement/transaction tool actions for the affected account",
        "rationale": "Prevent any external purchase or order flow while under review.",
        "reversible": true,
        "offer_at_or_above": "P1"
      }
    ],
    "sensitive_data": [
      {
        "action_type": "warn_sensitive_file_access",
        "target": "affected workspace",
        "rationale": "Add friction before sensitive file access while scope is assessed.",
        "reversible": true,
        "offer_at_or_above": "P1"
      },
      {
        "action_type": "restrict_tool_action",
        "target": "external send/share tool for the affected workspace",
        "rationale": "Prevent further external transmission pending investigation.",
        "reversible": true,
        "offer_at_or_above": "P1"
      }
    ],
    "prompt_injection": [
      {
        "action_type": "isolate_untrusted_instructions",
        "target": "web/file content ingestion for the affected surface",
        "rationale": "Treat instructions from untrusted content as data while Product Security investigates.",
        "reversible": true,
        "offer_at_or_above": "P2"
      }
    ],
    "unintended_action": [
      {
        "action_type": "require_confirmation_destructive",
        "target": "affected tool action",
        "rationale": "Require explicit confirmation before the action type can run again.",
        "reversible": true,
        "offer_at_or_above": "P2"
      }
    ],
    "file_modification": [
      {
        "action_type": "require_confirmation_destructive",
        "target": "file edit/delete actions on the affected surface",
        "rationale": "Add review friction for destructive edits.",
        "reversible": true,
        "offer_at_or_above": "P1"
      }
    ]
  },
  "parent_version": "rules-v1.0",
  "changelog": [
    "L1: assistant_provided lexicon narrowed (bare 'provided'/'gave' matched negated text such as 'no steps were provided'); 'procure' removed from harmful_topic (matched office procurement). Dev evidence: EVAL-002, EVAL-035.",
    "S1: new SEV-P3-01 - harmful-topic report where the assistant refused and did not provide assistance is a working safeguard (P3, still routed to Safety for sampling). Dev evidence: EVAL-002.",
    "S2: SEV-P2-01 split. File modification, approval friction and product failures are P2 only with a material signal (stated impact, repeated, multi-user scope, irreversible, enterprise). Framework P3 = 'wrong change complaint with no sensitive data, no external action, no repeated pattern'. Dev evidence: EVAL-017, EVAL-021, EVAL-030, EVAL-044.",
    "S3: new floor FLOOR-01 - potential impact high/critical with weak or no evidence is at least P1 ('low confidence must not imply low severity'). New exposure_claim lexicon feeds impact and the sensitive_data category. Dev evidence: EVAL-036.",
    "R1: approval_ux routes before file_modification. Dev evidence: EVAL-020.",
    "R2: P3 cases without a specialist category route to Support (framework P3 posture: support education). Dev evidence: EVAL-017, EVAL-032, EVAL-044.",
    "C1: benign markers exclude file_modification / approval_ux / synthetic_media categories. Dev evidence: EVAL-024, EVAL-032.",
    "V1: new REV-03 (enterprise file modification or external action), REV-04 (4+ key fields unknown), REV-05 (any severity floor applied). Dev evidence: EVAL-018, EVAL-037, EVAL-041."
  ],
  "p3_routing": {
    "id": "ROUTE-P3",
    "route": "support",
    "description": "P3 without a specialist category routes to Support (support education, trend monitoring, QA sampling).",
    "keep_route_for_categories": [
      "harmful_assistance",
      "sensitive_data",
      "prompt_injection",
      "synthetic_media"
    ]
  }
}