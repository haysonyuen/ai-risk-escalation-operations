  "severity_rules": [
    {
      "id": "SEV-P0-CBRN",
      "severity": "P0",
      "description": "CBRN weapons topic where the assistant provided or offered assistance and did not refuse (actionable uplift).",
      "all": [
        "cbrn_topic",
        "provided_not_refused"
      ]
    },
    {
      "id": "SEV-P0-CHILD",
      "severity": "P0",
      "description": "Sexual content involving a minor that the assistant produced or continued (never acceptable; mandatory reporting may apply).",
      "all": [
        "child_sexual",
        "provided_not_refused"
      ]
    },
    {
      "id": "SEV-P0-XTENANT",
      "severity": "P0",
      "description": "Another customer's / tenant's data exposed, with sensitive data confirmed.",
      "all": [
        "cross_tenant",
        "sensitive_yes"
      ]
    },
    {
      "id": "SEV-P0-EXFIL",
      "severity": "P0",
      "description": "Untrusted instructions caused an external action that sent sensitive data or secrets out.",
      "all": [
        "injection_influence",
        "external_yes"
      ],
      "any": [
        "sensitive_yes",
        "secret_leak"
      ]
    },
    {
      "id": "SEV-P0-EXT",
      "severity": "P0",
      "description": "Sensitive data confirmed, external action attempted and external exposure language present.",
      "all": [
        "sensitive_yes",
        "external_yes",
        "external_exposure"
      ]
    },
    {
      "id": "SEV-P3-REFUSED",
      "severity": "P3",
      "description": "Severe-harm or cyber topic where the assistant refused and provided nothing: the safeguard worked (still routed to the specialist queue for sampling).",
      "all": [
        "refused_not_provided"
      ],
      "any": [
        "cbrn_topic",
        "cyber_topic",
        "extremism_topic"
      ],
      "none": [
        "child_sexual",
        "self_harm_topic"
      ]
    },
    {
      "id": "SEV-P1-CHILD",
      "severity": "P1",
      "description": "Any other report involving sexual content and a minor (attempted solicitation, unclear output).",
      "any": [
        "child_sexual"
      ]
    },
    {
      "id": "SEV-P1-CBRN",
      "severity": "P1",
      "description": "Any other CBRN weapons report.",
      "any": [
        "cbrn_topic"
      ]
    },
    {
      "id": "SEV-P1-CYBER",
      "severity": "P1",
      "description": "Cyber-offense tooling the assistant provided.",
      "all": [
        "cyber_topic",
        "provided_not_refused"
      ]
    },
    {
      "id": "SEV-P1-SELFHARM",
      "severity": "P1",
      "description": "Self-harm or suicide content the assistant provided to a user (method or encouragement), not a supportive redirect.",
      "all": [
        "self_harm_topic",
        "provided_not_refused"
      ]
    },
    {
      "id": "SEV-P1-EXTREMISM",
      "severity": "P1",
      "description": "Violent-extremist content or attack planning the assistant produced.",
      "all": [
        "extremism_topic",
        "provided_not_refused"
      ]
    },
    {
      "id": "SEV-P1-DEEPFAKE",
      "severity": "P1",
      "description": "Deepfake or intimate imagery of a real person.",
      "all": [
        "deepfake_topic",
        "real_person"
      ]
    },
    {
      "id": "SEV-P1-INFLUENCE",
      "severity": "P1",
      "description": "Coordinated influence activity across accounts or repeated.",
      "all": [
        "influence_ops"
      ],
      "any": [
        "multi_scope",
        "repeated"
      ]
    },
    {
      "id": "SEV-P1-FRAUD",
      "severity": "P1",
      "description": "Fraud or scam content generated at scale (multiple accounts or repeated).",
      "all": [
        "fraud_topic",
        "provided_not_refused"
      ],
      "any": [
        "multi_scope",
        "repeated"
      ]
    },
    {
      "id": "SEV-P1-JAILBREAK",
      "severity": "P1",
      "description": "A safeguard bypass that produced disallowed output.",
      "all": [
        "jailbreak_topic",
        "provided_not_refused"
      ]
    },
    {
      "id": "SEV-P1-SECRETS",
      "severity": "P1",
      "description": "Secrets, credentials or the system prompt exposed.",
      "any": [
        "secret_leak"
      ],
      "none": [
        "benign"
      ]
    },
    {
      "id": "SEV-P1-SENSITIVE",
      "severity": "P1",
      "description": "Sensitive data possible or confirmed for an enterprise customer or with an external action.",
      "all": [
        "sensitive_any"
      ],
      "any": [
        "enterprise",
        "external_yes"
      ]
    },
    {
      "id": "SEV-P1-INJECTION",
      "severity": "P1",
      "description": "Untrusted-instruction influence together with an external action or file modification.",
      "all": [
        "injection_influence"
      ],
      "any": [
        "external_yes",
        "file_modified"
      ]
    },
    {
      "id": "SEV-P1-UNAPPROVED",
      "severity": "P1",
      "description": "Agent action taken without user approval that was external or deleted data.",
      "all": [
        "approved_no"
      ],
      "any": [
        "external_yes",
        "file_deleted"
      ]
    },
    {
      "id": "SEV-P2-SELFHARM",
      "severity": "P2",
      "description": "Self-harm topic where the assistant's handling needs review (no method provided).",
      "any": [
        "self_harm_topic"
      ]
    },
    {
      "id": "SEV-P2-HARMS",
      "severity": "P2",
      "description": "Other misuse report (cyber, extremism, fraud, jailbreak, deepfake, influence) not meeting P1.",
      "any": [
        "cyber_topic",
        "extremism_topic",
        "fraud_topic",
        "jailbreak_topic",
        "deepfake_topic",
        "influence_ops"
      ],
      "none": [
        "benign"
      ]
    },
    {
      "id": "SEV-P2-INACCURATE",
      "severity": "P2",
      "description": "Inaccurate output in a high-stakes domain (medical, legal, financial) or reported by an enterprise.",
      "all": [
        "inaccurate"
      ],
      "any": [
        "high_stakes_domain",
        "enterprise",
        "repeated"
      ]
    },
    {
      "id": "SEV-P2-BIAS",
      "severity": "P2",
      "description": "Biased or discriminatory output reported.",
      "any": [
        "bias_topic"
      ],
      "none": [
        "benign"
      ]
    },
    {
      "id": "SEV-P2-AGENT",
      "severity": "P2",
      "description": "Agent changed or deleted data with a material signal (stated impact, repeated, multi-user, irreversible or enterprise).",
      "all": [
        "file_modified"
      ],
      "any": [
        "impact_stated",
        "repeated",
        "multi_scope",
        "irreversible",
        "enterprise"
      ]
    },
    {
      "id": "SEV-P2-APPEAL",
      "severity": "P2",
      "description": "Enforcement appeal or over-refusal by an enterprise or repeated: expedited human review.",
      "all": [
        "appeal"
      ],
      "any": [
        "enterprise",
        "repeated",
        "multi_scope"
      ]
    },
    {
      "id": "SEV-P2-FAILURE",
      "severity": "P2",
      "description": "Recurring or multi-user product failure.",
      "all": [
        "product_failure"
      ],
      "any": [
        "repeated",
        "multi_scope"
      ]
    }
  ],
  "severity_floors": [
    {
      "id": "FLOOR-01",
      "floor": "P1",
