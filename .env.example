# Copy to .env (git-ignored). Only needed for the optional live model mode.
# Without a key, everything runs offline; live mode fails visibly and never falls back silently.
ANTHROPIC_API_KEY=
# Model used for live assessments and optional live drafting.
RISKOPS_LIVE_MODEL=claude-opus-5
RISKOPS_LIVE_TIMEOUT_SECONDS=60
# Optional: alternative database location.
# RISKOPS_DB_PATH=data/riskops.db
